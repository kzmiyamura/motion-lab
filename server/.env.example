# 待受ポート
PORT=4000

# CORS許可オリジン（カンマ区切りで複数指定可）
CORS_ORIGIN=https://motion-lab-apa.pages.dev,http://localhost:5173

# --- フォルダ別MD解析指示書パイプライン（docs/folder-analysis-detailed-design.md §10） ---

# 書き込み系APIの共有トークン。フロント側 VITE_HOME_SERVER_TOKEN と同値を設定する。
# 未設定の場合は無認証で素通し（ローカル開発用。本番では設定推奨）
API_WRITE_TOKEN=

# claude CLI のパス（PATHに無い場合はフルパスを指定）
CLAUDE_BIN=claude

# ジョブタイムアウト（ms）・リトライ上限
JOB_TIMEOUT_MS=3600000
JOB_MAX_RETRY=3

# Python 実行バイナリ（回転解析・ペア解析で共用）
# Windows 実機は PATH の python が Microsoft Store エイリアスに吸われるため
# フルパス指定が必要（例: C:\Users\admin\AppData\Local\Programs\Python\Python312\python.exe）
PYTHON_BIN=python3
